{
  "expo": {
    "name": "GoldOS",
    "slug": "goldos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "goldos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "lk.goldos.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "GoldOS uses the camera to scan product tags, old-gold numbers and invoice QR codes.",
        "NSPhotoLibraryUsageDescription": "GoldOS attaches photos of receipts and pieces you choose.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lk.goldos.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0A09",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A09",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GoldOS uses the camera to scan product tags, old-gold numbers and invoice QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GoldOS attaches photos of receipts and pieces you choose.",
          "cameraPermission": "GoldOS uses the camera to photograph receipts and pieces."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
