{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goldos-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://goldos-api.thufailahamed627.workers.dev"
  }
}
